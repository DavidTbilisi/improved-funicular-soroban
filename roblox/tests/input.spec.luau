--!nonstrict
local H = require("./harness")
local AbacusStore = require("../src/shared/state/AbacusStore")
local BoardInput = require("../src/client/BoardInput")
local Rod = require("../src/shared/domain/Rod")

local function digitAt(store, kind, idx)
  return Rod.rodValue(store:rodsOf(kind)[idx])
end

H.describe("BoardInput earth moves + legality")
local s = AbacusStore.new(0, "")
-- ones rod is int idx 1
H.ok(BoardInput.earthMove(s, "int", 1, 3, 1), "+3 earth legal from 0")
H.eq(digitAt(s, "int", 1), 3, "rod now shows 3")
H.ok(not BoardInput.earthMove(s, "int", 1, 3, 1), "+3 more is illegal (only 1 free earth) -> fault")
H.eq(digitAt(s, "int", 1), 3, "rod unchanged after refused move")
H.ok(BoardInput.earthMove(s, "int", 1, 1, 1), "+1 earth legal -> 4")
H.eq(digitAt(s, "int", 1), 4, "rod now 4")

H.describe("BoardInput heaven moves")
H.ok(BoardInput.heavenMove(s, "int", 1, 1), "+5 heaven legal from 4 -> 9")
H.eq(digitAt(s, "int", 1), 9, "rod now 9")
H.ok(not BoardInput.heavenMove(s, "int", 1, 1), "+5 again illegal (heaven already down)")
H.ok(BoardInput.heavenMove(s, "int", 1, -1), "-5 heaven legal from 9 -> 4")
H.eq(digitAt(s, "int", 1), 4, "rod now 4")

H.describe("BoardInput carry crosses to the next rod")
local s2 = AbacusStore.new(0, "")
-- put 9 on ones, then carry +10 to tens
BoardInput.earthMove(s2, "int", 1, 4, 1)
BoardInput.heavenMove(s2, "int", 1, 1) -- ones = 9
H.ok(BoardInput.carry(s2, "int", 1, 1), "carry +10 lands a unit on the tens rod")
H.eq(digitAt(s2, "int", 2), 1, "tens rod now 1")
H.eq(s2:intValue(), 19, "board reads 19")

H.describe("BoardInput carry target mapping")
local k, i = BoardInput.carryTarget("frac", 1)
H.eq(k, "int", "tenths carries into ones (kind)")
H.eq(i, 1, "tenths carries into ones (idx)")
H.eq(BoardInput.carryTarget("int", 11), nil, "top rod has no carry target")

H.describe("Faces.digitFromFaces — the chord keyboard's inverse")
local Faces = require("../src/shared/domain/Faces")
H.eq(Faces.digitFromFaces({}), 0, "empty set spells 0")
H.eq(Faces.digitFromFaces({ "center" }), 1, "center = 1")
H.eq(Faces.digitFromFaces({ "left" }), 2, "left = 2")
H.eq(Faces.digitFromFaces({ "top" }), 3, "top = 3")
H.eq(Faces.digitFromFaces({ "bottom" }), 4, "bottom = 4")
H.eq(Faces.digitFromFaces({ "right" }), 5, "right (rose) = 5")
H.eq(Faces.digitFromFaces({ "right", "center" }), 6, "rose + center = 6")
H.eq(Faces.digitFromFaces({ "left", "right" }), 7, "rose + left = 7 (order-free)")
H.eq(Faces.digitFromFaces({ "top", "right" }), 8, "rose + top = 8")
H.eq(Faces.digitFromFaces({ "right", "bottom" }), 9, "rose + bottom = 9")
H.eq(Faces.digitFromFaces({ "top", "bottom" }), 1, "top+bottom stands in for center")
H.eq(Faces.digitFromFaces({ "top", "bottom", "right" }), 6, "top+bottom+rose = 6")
H.eq(Faces.digitFromFaces({ "left", "top" }), nil, "two earth cells is not a die face")
H.eq(Faces.digitFromFaces({ "elbow" }), nil, "an unknown cell is not a die face")

H.describe("BoardInput.pressWhole — whole digits, strict direct-only")
local s3 = AbacusStore.new(0, "")
H.ok(BoardInput.pressWhole(s3, "int", 1, 7, 1), "+7 on 0 is direct (rose + 2 earth)")
H.eq(digitAt(s3, "int", 1), 7, "rod now 7")
H.ok(not BoardInput.pressWhole(s3, "int", 1, 7, 1), "+7 on 7 needs a carry -> refused")
H.eq(digitAt(s3, "int", 1), 7, "rod unchanged after refusal")
H.ok(BoardInput.pressWhole(s3, "int", 1, 7, -1), "-7 on 7 is direct")
H.eq(digitAt(s3, "int", 1), 0, "rod back to 0")
H.ok(not BoardInput.pressWhole(s3, "int", 1, 6, -1), "-6 on 0 refused")
H.ok(BoardInput.pressWhole(s3, "int", 1, 4, 1), "+4 delegates to the 1..5 path")
H.ok(not BoardInput.pressWhole(s3, "int", 1, 9, 1), "+9 on 4 needs a carry -> refused")

H.report("input.spec")
